---
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';
import ProjectCard from './project-card.astro';

// Projects with a `featured` number in their frontmatter, in that order
const featured = (await getCollection('projects', ({ data }) => data.featured !== undefined))
  .sort((a, b) => a.data.featured! - b.data.featured!)
  .slice(0, 3);
---

<section id="projects" class="section-container overflow-hidden">
  <div class="container mx-auto">
    <div class="mb-16 project-header">
      <h2 class="text-3xl md:text-4xl font-heading font-bold text-maintext mb-2 flex items-center gap-4">
          <span class="text-accent">/</span> Featured Projects
        </h2>
      <p class="text-subtext font-body text-sm max-w-md">
        A few projects I'm proud of: game jams, engine work and school projects.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {featured.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>

    <div class="flex justify-center mt-12">
      <a
        href="/projects/"
        class="inline-flex items-center gap-2 px-8 py-2.5 rounded-full border border-accent/40 bg-accent/10 text-maintext font-body text-sm font-medium hover:border-accent hover:bg-accent/20 hover:scale-105 transition-all duration-300"
      >
        View all projects
        <Icon name="mdi:arrow-right" class="w-4 h-4 text-accent" />
      </a>
    </div>
  </div>
</section>


<style>
  /* Header Initial State */
  .project-header {
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .project-header.reveal {
    opacity: 1 !important;
    transform: translateY(0);
  }
</style>

<script>
  const initProjectHeaderReveal = () => {
    const header = document.querySelector('.project-header');
    if (!header) return;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('reveal');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.15, rootMargin: '0px 0px -10px 0px' });

    observer.observe(header);
  };

  initProjectHeaderReveal();
  document.addEventListener('astro:after-swap', initProjectHeaderReveal);
</script>
