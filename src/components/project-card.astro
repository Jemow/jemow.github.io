---
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, description, heroImage, category, engine, tags } = project.data;
const chips = [...(engine ? [engine] : []), ...tags];

const categoryColors: Record<string, string> = {
  'Game Jams': 'text-violet-400 bg-violet-400/10 border-violet-400/20',
  'Academic':  'text-sky-400 bg-sky-400/10 border-sky-400/20',
  'Personal':  'text-emerald-400 bg-emerald-400/10 border-emerald-400/20',
};
const categoryClass = categoryColors[category] ?? 'text-accent bg-accent/10 border-accent/20';
---

<a
  href={`/projects/${project.id}/`}
  class="project-card group relative bg-accent/5 border border-accent/10 rounded-2xl overflow-hidden hover:border-accent/40 transition-all duration-500 flex flex-col"
>

  <!-- Image area -->
  <div class="aspect-video overflow-hidden relative bg-background/50 shrink-0">
    {heroImage ? (
      <Image
        src={heroImage}
        alt={title}
        width={800}
        class="absolute inset-0 w-full h-full object-cover transition-all duration-1000 group-hover:scale-110"
      />
    ) : (
      <img
        src="/placeholder.jpeg"
        alt={`${title} placeholder`}
        class="absolute inset-0 w-full h-full object-cover transition-all duration-1000 group-hover:scale-110"
      />
    )}
  </div>

  <!-- Card body -->
  <div class="p-6 flex flex-col gap-3 flex-1">
    <div>
      <span class={`inline-block text-[10px] uppercase tracking-widest font-bold px-2 py-0.5 rounded-full border ${categoryClass}`}>
        {category}
      </span>
      <h3 class="text-xl font-heading font-bold text-maintext mt-2">{title}</h3>
    </div>

    <p class="text-subtext text-sm font-body line-clamp-3 flex-1">
      {description}
    </p>

    <!-- Tags -->
    {chips.length > 0 && (
      <div class="flex flex-wrap gap-2">
        {chips.map((t) => (
          <span class="rounded-md text-[10px] px-2 md:px-3 py-1 bg-accent/5 border border-accent/10 text-accent/80 group-hover:border-accent/40 group-hover:text-accent transition-colors duration-300">
            {t}
          </span>
        ))}
      </div>
    )}

    <!-- View Project Button -->
    <span
      class="mt-1 flex items-center justify-center gap-2 w-full py-2 rounded-lg border border-accent/20 text-accent/70 group-hover:text-accent group-hover:border-accent/60 group-hover:bg-accent/5 transition-all duration-300 text-xs font-body font-semibold tracking-wide"
    >
      View Project
      <Icon name="mdi:arrow-right" class="w-3.5 h-3.5" />
    </span>
  </div>
</a>

<script>
  // Fade cards in as they scroll into view (staggered per row of 3)
  const initCardReveal = () => {
    const cards = document.querySelectorAll('.project-card');
    const cardIndexMap = new Map<Element, number>();
    cards.forEach((card, i) => cardIndexMap.set(card, i));

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const index = cardIndexMap.get(entry.target) ?? 0;
          setTimeout(() => {
            entry.target.classList.add('reveal');
          }, (index % 3) * 150);
          observer.unobserve(entry.target);
        }
      });
    }, {
      threshold: 0.15,
      rootMargin: '0px 0px -10px 0px'
    });

    cards.forEach(card => observer.observe(card));
  };

  initCardReveal();
  document.addEventListener('astro:after-swap', initCardReveal);
</script>

<style is:global>
  .project-card {
    opacity: 0;
    visibility: hidden;
    transform: translateY(40px);
    transition:
      opacity 0.8s ease-out,
      transform 0.8s cubic-bezier(0.16, 1, 0.3, 1),
      visibility 0.8s;
    will-change: transform, opacity;
  }

  .project-card.reveal {
    opacity: 1 !important;
    visibility: visible !important;
    transform: translateY(0) !important;
  }
</style>
