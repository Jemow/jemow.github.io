---
import { getCollection } from 'astro:content';
import { PROJECT_CATEGORIES } from '../../content.config';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/nav.astro';
import ProjectCard from '../../components/project-card.astro';
import Footer from '../../components/footer.astro';

const projects = (await getCollection('projects')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const groups = PROJECT_CATEGORIES
  .map((category) => ({ category, items: projects.filter((p) => p.data.category === category) }))
  .filter((group) => group.items.length > 0);
---

<Layout title="Projects | Jemo" description="All my projects: game jams, academic work and personal projects.">
  <Nav />

  <section class="section-container md:pt-36">
    <div class="container mx-auto">
      <div class="mb-12">
        <h1 class="text-4xl md:text-5xl font-heading font-bold text-maintext mb-2 flex items-center gap-4">
          <span class="text-accent">/</span> All Projects
        </h1>
        <p class="text-subtext font-body text-sm max-w-md">
          Everything I've built so far, by category.
        </p>

        <div class="flex gap-2 flex-wrap mt-6">
          {groups.map(({ category, items }) => (
            <a
              href={`#${category.toLowerCase().replace(/\s+/g, '-')}`}
              class="text-[10px] uppercase tracking-widest font-bold px-3 py-1 rounded-full border border-accent/30 text-accent/70 hover:border-accent hover:text-accent hover:bg-accent/10 transition-all duration-200"
            >
              {category} ({items.length})
            </a>
          ))}
        </div>
      </div>

      <div class="space-y-16">
        {groups.map(({ category, items }) => (
          <div id={category.toLowerCase().replace(/\s+/g, '-')} class="scroll-mt-28">
            <h2 class="text-maintext font-body text-[11px] uppercase tracking-[0.4em] ml-1 mb-6">
              {category}
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
              {items.map((project) => (
                <ProjectCard project={project} />
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Footer />
</Layout>
