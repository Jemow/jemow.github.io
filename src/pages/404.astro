---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/nav.astro';
---

<Layout title="Page not found | Jemo">
  <Nav />
  <section class="section-container flex flex-col items-center justify-center min-h-[80vh] text-center gap-4">
    <p class="font-mono text-accent text-sm tracking-[0.3em]">404</p>
    <h1 class="text-4xl md:text-6xl font-heading font-bold text-maintext">Page not found</h1>
    <p class="text-subtext">This page doesn't exist, or it moved.</p>
    <a
      href="/"
      class="mt-4 inline-flex items-center px-8 py-2.5 rounded-full border border-accent/40 bg-accent/10 text-maintext text-sm hover:border-accent hover:bg-accent/20 transition-all duration-300"
    >
      Back home
    </a>
  </section>
</Layout>
